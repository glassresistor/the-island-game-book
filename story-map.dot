digraph TheIsland {
  rankdir=TB;
  fontname="Helvetica"; node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge [fontname="Helvetica", fontsize=8];

  // ===== COLOR LEGEND =====
  subgraph cluster_legend { label="legend"; style=dashed;
    "START" [fillcolor="#cde7ff"]; "CORE" [fillcolor="#ffffff"]; "DECISION" [fillcolor="#fff2cc"]; "SIDE QUEST" [fillcolor="#fce4ec"]; "ENDING" [fillcolor="#d9ead3"]; }

  "entrypoint" [fillcolor="#cde7ff", label="entrypoint\n─────────────\nWHO DOES WHAT:\nBoth voices intro; READER picks purple(Sunday)/pink(Dix). Sets perspective, resets vars.\n─────────────\nSOURCE: the_island_plain.txt ~L9"];
  "wake" [fillcolor="#ffffff", label="wake\n─────────────\nWHO DOES WHAT:\nSUNDAY thaws, meets newborn son Dix. Chooses lean: heart | mission.\n─────────────\nSOURCE: the_island_plain.txt ~L63"];
  "tac-tank" [fillcolor="#ffffff", label="tac-tank\n─────────────\nWHO DOES WHAT:\nSUNDAY briefs at tac tank; finds flickering dwarf + signal. Orders vons to build grid.\n─────────────\nSOURCE: the_island_plain.txt ~L122"];
  "discovery" [fillcolor="#ffffff", label="discovery\n─────────────\nWHO DOES WHAT:\n10 mo later. SUNDAY+DIX split display; find knife-edged photosynthetic gas bubble ~350ls around 428.\n─────────────\nSOURCE: the_island_plain.txt ~L323"];
  "mind" [fillcolor="#ffffff", label="mind\n─────────────\nWHO DOES WHAT:\nSUNDAY runs spectro+mass/synapse math; vast intelligent membrane. Decides to shout back.\n─────────────\nSOURCE: the_island_plain.txt ~L468"];
  "trace" [fillcolor="#fff2cc", label="trace\n─────────────\nWHO DOES WHAT:\nGAMEBOOK-ORIGINAL pause. SUNDAY picks meaning (physiology/stop/hail). DIX hardcoded=stop, silent.\n─────────────\nSOURCE: GAMEBOOK-ORIGINAL (nearest source ~txt L610)"];
  "crypt" [fillcolor="#ffffff", label="crypt\n─────────────\nWHO DOES WHAT:\nShout back. SUNDAY->crypt->commons; sees pigment waves @ ~59,000 km/s. Chooses lean again.\n─────────────\nSOURCE: the_island_plain.txt ~L616"];
  "commons" [fillcolor="#fff2cc", label="commons\n─────────────\nWHO DOES WHAT:\nNEW: the long walk crypt->library through Eriophora's dark corridors (dead-eye sensor, fading lights). Ends at an unmarked airlock door. READER chooses: push through (side quest) or stay on the lit path.\n─────────────\nSOURCE: NEW (gamebook-original; physical-space expansion)"];
  "airlock" [fillcolor="#fce4ec", label="airlock\n─────────────\nWHO DOES WHAT:\nNEW SIDE QUEST: Dix/Sunday open the sealed airlock into a scorched Great-Struggle corridor; find a dead teleop whose log reveals the chimp has KNOWN about the Island for 11,000 builds and never said. Sets log_found=1.\n─────────────\nSOURCE: NEW (gamebook-original side quest; Great Struggle + chimp-secrecy theme)"];
  "library" [fillcolor="#ffffff", label="library\n─────────────\nWHO DOES WHAT:\nSUNDAY studies the Island; concludes violence is planetary, Island likely benign. DIX follows. If log_found=1, opens with the weight of the dead teleop's secret.\n─────────────\nSOURCE: the_island_plain.txt ~L1398"];
  "home-invasion" [fillcolor="#fff2cc", label="home-invasion\n─────────────\nWHO DOES WHAT:\nDIX invades SUNDAY's quarters; she catches chimp coaching him. Offers to burn link. Sets dix_burned.\n─────────────\nSOURCE: the_island_plain.txt ~L818"];
  "library-argument" [fillcolor="#ffffff", label="library-argument\n─────────────\nWHO DOES WHAT:\nSUNDAY argues w/ DIX (physics, mission, killing Island); escalates. Finds other parent = Kai.\n─────────────\nSOURCE: the_island_plain.txt ~L1481"];
  "parents" [fillcolor="#ffffff", label="parents\n─────────────\nWHO DOES WHAT:\nSUNDAY learns Kai+Connie died 3 builds back; hits DIX, then they sit & talk. She licks his lip.\n─────────────\nSOURCE: the_island_plain.txt ~L1733"];
  "the-deal" [fillcolor="#fff2cc", label="the-deal\n─────────────\nWHO DOES WHAT:\nDIX on hull walkabout; SUNDAY threatens to kill Dix unless chimp gives her a say in the gate. Sets deal.\n─────────────\nSOURCE: the_island_plain.txt ~L1982"];
  "final-hub" [fillcolor="#fff2cc", label="final-hub\n─────────────\nWHO DOES WHAT:\nFinal approach; Island signals panic (gate still on path). SUNDAY makes ending choice.\n─────────────\nSOURCE: txt L2145 + final approach"];
  "end-weapon" [fillcolor="#d9ead3", label="end-weapon\n─────────────\nWHO DOES WHAT:\nEND: move gate as asked; it was a weapon - something else comes through & dies.\n─────────────\nSOURCE: the_island_plain.txt ~L2303"];
  "end-cargo" [fillcolor="#d9ead3", label="end-cargo\n─────────────\nWHO DOES WHAT:\nEND (gamebook-original opposite): hold line, mission runs Island over. Only if NOT deal.\n─────────────\nSOURCE: GAMEBOOK-ORIGINAL ('opposite' ending - no direct source)"];
  "end-almost" [fillcolor="#d9ead3", label="end-almost\n─────────────\nWHO DOES WHAT:\nEND: save it + stay to build pidgin; realizes 'new' signal was her own loneliness.\n─────────────\nSOURCE: the_island_plain.txt ~L2235"];
  "end-rebellion" [fillcolor="#d9ead3", label="end-rebellion\n─────────────\nWHO DOES WHAT:\nEND: SUNDAY+DIX (only if dix_burned) quietly slow the mission.\n─────────────\nSOURCE: derived: txt L670 mission-stmt + Great Struggle"];
  "end-silence" [fillcolor="#d9ead3", label="end-silence\n─────────────\nWHO DOES WHAT:\nEND: SUNDAY burns her link, goes to crypt, refuses to choose for machine or self.\n─────────────\nSOURCE: derived: txt L1119 'watch any point in time'"];

  // ===== EDGES (label = variables set on the link) =====
  "entrypoint" -> "wake" [label="purple: perspective=void
pink: perspective=pink"];
  "wake" -> "tac-tank" [label="lean=heart | lean=mission"];
  "tac-tank" -> "discovery" [label="(none)"];
  "discovery" -> "mind" [label="(none)"];
  "mind" -> "trace" [label="(none)"];
  "trace" -> "crypt" [label="physiology | stop(DIX)
| hail"];
  "crypt" -> "commons" [label="log_found=0 (start)"];
  "commons" -> "airlock" [style=dashed] [label="PUSH THROUGH (side quest)"];
  "commons" -> "library" [label="stay on lit path
log_found=0"];
  "airlock" -> "library" [label="log_found=1 (secret learned)"];
  "library" -> "home-invasion" [label="lean=heart | lean=mission"];
  "home-invasion" -> "library-argument" [label="dix_burned=1 | dix_burned=0"];
  "library-argument" -> "parents" [label="(none)"];
  "parents" -> "the-deal" [label="(none)"];
  "the-deal" -> "final-hub" [label="deal=1 | deal=0"];
  "final-hub" -> "end-weapon" [label="move gate (always)"];
  "final-hub" -> "end-cargo" [style=dashed] [label="hold line
(only if NOT deal)"];
  "final-hub" -> "end-almost" [label="save+stay (always)"];
  "final-hub" -> "end-rebellion" [style=dashed] [label="rebel w/ Dix
(only if dix_burned)"];
  "final-hub" -> "end-silence" [style=dashed] [label="go quiet
(only if NOT dix_burned)"];
}